{% liquid
  assign item_type = "Outfit"
  assign p_title_lower = product.title | downcase
  assign p_type_lower = product.type | downcase

  if product.type != blank
    assign item_type = product.type
  endif

  if p_title_lower contains 'jewel' or p_title_lower contains 'necklace' or p_title_lower contains 'choker' or p_title_lower contains 'earring' or p_title_lower contains 'kundan' or p_title_lower contains 'bangle' or p_type_lower contains 'jewel'
    assign item_type = "Jewellery"
  elsif p_title_lower contains 'lehenga' or p_title_lower contains 'choli' or p_type_lower contains 'lehenga'
    assign item_type = "Lehenga"
  elsif p_title_lower contains 'sherwani' or p_title_lower contains 'kurta' or p_title_lower contains 'indo-western' or p_type_lower contains 'sherwani'
    assign item_type = "Sherwani"
  elsif p_title_lower contains 'saree' or p_title_lower contains 'sari' or p_type_lower contains 'saree'
    assign item_type = "Saree"
  elsif p_title_lower contains 'gown' or p_type_lower contains 'gown'
    assign item_type = "Gown"
  elsif p_title_lower contains 'anarkali' or p_type_lower contains 'anarkali'
    assign item_type = "Anarkali"
  elsif p_title_lower contains 'suit' or p_title_lower contains 'tuxedo' or p_type_lower contains 'suit'
    assign item_type = "Suit"
  else
    for collection in product.collections
      assign col_title = collection.title | downcase
      if col_title contains 'jewel'
        assign item_type = "Jewellery"
        break
      elsif col_title contains 'lehenga'
        assign item_type = "Lehenga"
        break
      elsif col_title contains 'sherwani'
        assign item_type = "Sherwani"
        break
      elsif col_title contains 'saree'
        assign item_type = "Saree"
        break
      elsif col_title contains 'gown'
        assign item_type = "Gown"
        break
      endif
    endfor
  endif

  assign widget_heading = "Rent This " | append: item_type
  if block.settings.heading != blank and block.settings.heading != "Rent This Outfit"
    assign widget_heading = block.settings.heading
  endif

  assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first

  # Smart Per-Product Pricing Detection:
  # 1. Product Metafields (rental.price, custom.rental_price, custom.rent)
  # 2. Product Tags (e.g., rent:5000, rental:5000, rent_5000)
  # 3. Product Selling Price if use_product_price is enabled
  # 4. Block settings fallback
  assign initial_rental_price = product.metafields.rental.price | default: product.metafields.custom.rental_price | default: product.metafields.custom.rent
  if initial_rental_price == blank
    for tag in product.tags
      assign tag_lower = tag | downcase | strip
      if tag_lower contains 'rent:' or tag_lower contains 'rental:' or tag_lower contains 'rent_' or tag_lower contains 'rental_'
        if tag_lower contains ':'
          assign tag_price_val = tag | split: ':' | last | strip
        else
          assign tag_price_val = tag | split: '_' | last | strip
        endif
        if tag_price_val != blank
          assign initial_rental_price = tag_price_val
          break
        endif
      endif
    endfor
  endif

  if initial_rental_price == blank
    if block.settings.use_product_price and product.price > 0
      assign initial_rental_price = product.price | money
    else
      assign initial_rental_price = block.settings.rental_price | default: "₹5,500"
    endif
  endif

  unless initial_rental_price contains "₹" or initial_rental_price contains "Rs" or initial_rental_price contains "$"
    assign initial_rental_price = "₹" | append: initial_rental_price
  endunless

  # Smart Per-Product Deposit Detection:
  # 1. Product Metafields (rental.deposit, custom.security_deposit, custom.deposit)
  # 2. Product Tags (e.g., deposit:3000, security:2500, deposit_1500, security_1500)
  # 3. Block settings fallback
  assign initial_deposit = product.metafields.rental.deposit | default: product.metafields.custom.security_deposit | default: product.metafields.custom.deposit
  if initial_deposit == blank
    for tag in product.tags
      assign tag_lower = tag | downcase | strip
      if tag_lower contains 'deposit:' or tag_lower contains 'security:' or tag_lower contains 'deposit_' or tag_lower contains 'security_'
        if tag_lower contains ':'
          assign tag_dep_val = tag | split: ':' | last | strip
        else
          assign tag_dep_val = tag | split: '_' | last | strip
        endif
        if tag_dep_val != blank
          assign initial_deposit = tag_dep_val
          break
        endif
      endif
    endfor
  endif

  if initial_deposit == blank
    assign initial_deposit = block.settings.deposit | default: "₹2,000"
  endif

  unless initial_deposit contains "₹" or initial_deposit contains "Rs" or initial_deposit contains "$"
    assign initial_deposit = "₹" | append: initial_deposit
  endunless
%}

<div class="gm-rental-widget" id="gm-rental-{{ section.id }}">
  <div class="gm-rental-card">

    <div class="gm-rental-header">
      <div class="gm-rental-header-top">
        <h3 class="gm-rental-title">{{ widget_heading }}</h3>
        <span class="gm-rental-badge">{{ item_type }}</span>
      </div>
      <p class="gm-rental-sub">{{ block.settings.subheading }}</p>
    </div>

    <!-- Smart Synced Dates Indicator -->
    <div class="gm-rental-sync-banner" style="display: none;">
      <div class="gm-sync-info">
        <span class="gm-sync-icon">✨</span>
        <span class="gm-sync-text">Dates auto-synced from your Rental Bag</span>
      </div>
      <button type="button" class="gm-sync-reset" title="Clear synced dates">✕ Reset</button>
    </div>

    <!-- Dynamic Rental Price for THIS Product -->
    <div class="gm-rental-price">
      <span>Rental Price</span>
      <strong class="gm-price-val">{{ initial_rental_price }}</strong>
    </div>

    <!-- Dynamic Security Deposit for THIS Product -->
    <div class="gm-rental-deposit">
      <span>Security Deposit (Refundable)</span>
      <strong class="gm-deposit-val">{{ initial_deposit }}</strong>
    </div>

    <!-- Rental Booking Dates Selection -->
    <div class="gm-rental-dates">

      <div class="gm-rental-field">
        <label for="gm-pickup-{{ section.id }}">
          Pickup Date *
        </label>
        <input
          type="date"
          id="gm-pickup-{{ section.id }}"
          class="gm-rental-pickup"
          required
        >
      </div>

      <div class="gm-rental-field">
        <label for="gm-return-{{ section.id }}">
          Return Date *
        </label>
        <input
          type="date"
          id="gm-return-{{ section.id }}"
          class="gm-rental-return"
          required
        >
      </div>

    </div>

    <!-- Real-time Availability & Error Notification Banner -->
    <div class="gm-rental-message" aria-live="polite"></div>

    <!-- Action Buttons -->
    <div class="gm-rental-buttons">

      <!-- Button 1: Multi-Item Add to Bag -->
      <button
        type="button"
        class="gm-rental-add-bag"
      >
        <svg class="gm-btn-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span>{{ block.settings.add_to_bag_text | default: "+ Add to Rental Bag (Rent More)" }}</span>
      </button>

      <!-- Button 2: 1-Click Instant Checkout -->
      <button
        type="button"
        class="gm-rental-book"
      >
        <svg class="gm-btn-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>{{ block.settings.book_text | default: "Book Now" }}</span>
      </button>

      <!-- Button 3: WhatsApp Inquiry -->
      {% if block.settings.whatsapp_number != blank %}
        <a
          href="#"
          class="gm-rental-whatsapp"
          target="_blank"
          rel="noopener"
        >
          <svg class="gm-btn-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>{{ block.settings.whatsapp_text | default: "Rent Through WhatsApp" }}</span>
        </a>
      {% endif %}

    </div>

    <!-- Clarification Note -->
    <div class="gm-rental-note">
      {{ block.settings.note | default: "Customer & shipping details are collected on the next page (Checkout). Our stylist will contact you for measurement and delivery scheduling." }}
    </div>

  </div>
</div>

<!-- MULTI-ITEM RENTAL BAG MODAL -->
<div class="gm-rental-modal-backdrop" id="gm-rental-modal-{{ section.id }}" style="display: none;">
  <div class="gm-rental-modal-dialog">
    <div class="gm-rental-modal-header">
      <div class="gm-modal-title-wrap">
        <h4 class="gm-rental-modal-title">🛍️ Your Rental Bag</h4>
        <span class="gm-modal-items-count">0 items</span>
      </div>
      <button type="button" class="gm-rental-modal-close" aria-label="Close modal">✕</button>
    </div>

    <div class="gm-rental-modal-alert">
      ✨ <strong>Combined Rental:</strong> Rent multiple outfits & matching jewellery in a single checkout!
    </div>

    <div class="gm-rental-modal-body">
      <div class="gm-rental-items-list">
        <!-- Dynamically rendered via JS -->
      </div>

      <div class="gm-rental-modal-summary">
        <div class="gm-summary-row">
          <span>Estimated Rental Total</span>
          <strong class="gm-modal-total-price">₹0</strong>
        </div>
        <div class="gm-summary-row gm-deposit-sub">
          <span>Refundable Security Deposit</span>
          <span class="gm-modal-total-deposit">₹0</span>
        </div>
      </div>
    </div>

    <div class="gm-rental-modal-footer">
      <button type="button" class="gm-btn-continue">
        🛍️ Browse More Items
      </button>
      <button type="button" class="gm-btn-checkout">
        Proceed to Checkout ➔
      </button>
    </div>
  </div>
</div>

<!-- FLOATING STICKY RENTAL BAR (Visible on all product pages when items are in rental bag) -->
<div class="gm-rental-floating-bar" id="gm-rental-floating-{{ section.id }}" style="display: none;">
  <div class="gm-floating-content">
    <div class="gm-floating-badge">
      <span class="gm-floating-icon">👗💍</span>
      <span class="gm-floating-text">
        <strong>Rental Bag:</strong> <span class="gm-floating-count">1 item</span>
      </span>
    </div>
    <div class="gm-floating-actions">
      <button type="button" class="gm-floating-view-btn">View Bag</button>
      <button type="button" class="gm-floating-checkout-btn">Checkout ➔</button>
    </div>
  </div>
</div>

<style>
  /* ============================================================
     1. BASE CONTAINER & ADAPTIVE CARD (LIGHT/DARK THEME ADAPTIVE)
     ============================================================ */
  #gm-rental-{{ section.id }} {
    margin: 20px 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    font-family: inherit;
  }

  #gm-rental-{{ section.id }} *,
  #gm-rental-{{ section.id }} *::before,
  #gm-rental-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #gm-rental-{{ section.id }} .gm-rental-card {
    border: 1px solid rgba(128, 128, 128, 0.28);
    border-radius: 12px;
    padding: 20px;
    background: var(--gradient-background, var(--color-background, transparent));
    backdrop-filter: blur(8px);
    color: var(--color-foreground, currentColor);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    width: 100%;
  }

  /* Header */
  #gm-rental-{{ section.id }} .gm-rental-header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  #gm-rental-{{ section.id }} .gm-rental-header h3 {
    margin: 0;
    font-size: 21px;
    font-weight: 700;
    color: var(--color-foreground, currentColor);
    font-family: inherit;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  #gm-rental-{{ section.id }} .gm-rental-badge {
    background: rgba(121, 100, 255, 0.14);
    color: #7964FF;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  #gm-rental-{{ section.id }} .gm-rental-header p {
    margin: 0 0 14px;
    color: var(--color-foreground, currentColor);
    opacity: 0.75;
    font-size: 13.5px;
    line-height: 1.4;
  }

  /* Sync Banner */
  #gm-rental-{{ section.id }} .gm-rental-sync-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: rgba(121, 100, 255, 0.08);
    border: 1px dashed #7964FF;
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 14px;
    font-size: 12px;
    color: var(--color-foreground, currentColor);
    flex-wrap: wrap;
  }

  #gm-rental-{{ section.id }} .gm-sync-info {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    min-width: 180px;
  }

  #gm-rental-{{ section.id }} .gm-sync-reset {
    background: transparent;
    border: 0;
    color: #7964FF;
    cursor: pointer;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    white-space: nowrap;
    text-decoration: underline;
  }
  #gm-rental-{{ section.id }} .gm-sync-reset:hover {
    background: rgba(121, 100, 255, 0.15);
  }

  /* Pricing rows */
  #gm-rental-{{ section.id }} .gm-rental-price,
  #gm-rental-{{ section.id }} .gm-rental-deposit {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid rgba(128, 128, 128, 0.18);
    color: var(--color-foreground, currentColor);
    font-size: 14.5px;
    flex-wrap: nowrap;
  }

  #gm-rental-{{ section.id }} .gm-rental-price span,
  #gm-rental-{{ section.id }} .gm-rental-deposit span {
    opacity: 0.9;
    font-weight: 500;
  }

  #gm-rental-{{ section.id }} .gm-rental-price strong,
  #gm-rental-{{ section.id }} .gm-rental-deposit strong {
    font-size: 19px;
    font-weight: 700;
    color: var(--color-foreground, currentColor);
    text-align: right;
  }

  /* Date fields */
  #gm-rental-{{ section.id }} .gm-rental-dates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 16px;
  }

  #gm-rental-{{ section.id }} .gm-rental-field label {
    display: block;
    margin-bottom: 5px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-foreground, currentColor);
    opacity: 0.92;
  }

  #gm-rental-{{ section.id }} .gm-rental-field input {
    width: 100%;
    min-height: 44px;
    padding: 9px 12px;
    border: 1px solid rgba(128, 128, 128, 0.35);
    border-radius: 8px;
    font-size: 15px;
    background: var(--gradient-background, var(--color-background, rgba(255, 255, 255, 0.05)));
    color: var(--color-foreground, currentColor);
    color-scheme: light dark;
    font-family: inherit;
    -webkit-appearance: none;
    appearance: none;
  }

  #gm-rental-{{ section.id }} .gm-rental-field input:focus {
    outline: none;
    border-color: #7964FF;
    box-shadow: 0 0 0 2px rgba(121, 100, 255, 0.25);
  }

  /* Status message */
  #gm-rental-{{ section.id }} .gm-rental-message {
    margin-top: 12px;
    padding: 12px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.4;
    display: none;
    word-break: break-word;
  }

  /* Buttons */
  #gm-rental-{{ section.id }} .gm-rental-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
  }

  #gm-rental-{{ section.id }} .gm-btn-svg {
    flex-shrink: 0;
    margin-right: 8px;
  }

  /* Button 1: Add to Rental Bag */
  #gm-rental-{{ section.id }} .gm-rental-add-bag {
    width: 100%;
    min-height: 48px;
    border: 2px solid #7964FF;
    background: rgba(121, 100, 255, 0.06);
    color: #7964FF;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    padding: 10px 14px;
    transition: all 0.2s ease;
    font-family: inherit;
    text-align: center;
  }

  #gm-rental-{{ section.id }} .gm-rental-add-bag:hover {
    background: #7964FF;
    color: #FFFFFF;
    box-shadow: 0 4px 14px rgba(121, 100, 255, 0.3);
  }

  #gm-rental-{{ section.id }} .gm-rental-add-bag:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Button 2: Direct Book & Checkout */
  #gm-rental-{{ section.id }} .gm-rental-book {
    width: 100%;
    min-height: 48px;
    border: 0;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    padding: 10px 14px;
    transition: all 0.2s ease;
    font-family: inherit;
    background: var(--color-button, var(--color-base-accent-1, #2E3346));
    color: var(--color-button-text, #FFFFFF);
    text-align: center;
  }

  #gm-rental-{{ section.id }} .gm-rental-book:hover {
    filter: brightness(0.92);
  }

  #gm-rental-{{ section.id }} .gm-rental-book:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    filter: none;
  }

  /* Button 3: WhatsApp */
  #gm-rental-{{ section.id }} .gm-rental-whatsapp {
    width: 100%;
    min-height: 46px;
    border: 0;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    padding: 10px 14px;
    transition: all 0.2s ease;
    font-family: inherit;
    background: #25D366;
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(37, 211, 102, 0.25);
    text-align: center;
  }

  #gm-rental-{{ section.id }} .gm-rental-whatsapp:hover {
    background: #20BA5A;
  }

  #gm-rental-{{ section.id }} .gm-rental-note {
    margin-top: 14px;
    font-size: 12px;
    color: var(--color-foreground, currentColor);
    opacity: 0.72;
    line-height: 1.45;
  }

  /* ============================================================
     2. MULTI-ITEM MODAL (RESPONSIVE)
     ============================================================ */
  .gm-rental-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(5px);
    z-index: 9999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
  }

  .gm-rental-modal-dialog {
    background: var(--gradient-background, var(--color-background, #FFFFFF));
    color: var(--color-foreground, #2E3346);
    border: 1px solid rgba(128, 128, 128, 0.3);
    border-radius: 14px;
    max-width: 500px;
    width: 100%;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
    overflow: hidden;
    animation: gmFadeIn 0.22s ease-out;
  }

  @keyframes gmFadeIn {
    from { opacity: 0; transform: translateY(12px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .gm-rental-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(128, 128, 128, 0.2);
  }

  .gm-modal-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .gm-rental-modal-title {
    margin: 0;
    font-size: 17.5px;
    font-weight: 700;
  }

  .gm-modal-items-count {
    font-size: 12px;
    color: #7964FF;
    font-weight: 700;
    background: rgba(121, 100, 255, 0.12);
    padding: 2px 8px;
    border-radius: 12px;
  }

  .gm-rental-modal-close {
    background: transparent;
    border: 0;
    font-size: 20px;
    cursor: pointer;
    color: var(--color-foreground, currentColor);
    opacity: 0.7;
    padding: 4px;
    line-height: 1;
  }
  .gm-rental-modal-close:hover { opacity: 1; }

  .gm-rental-modal-alert {
    background: rgba(121, 100, 255, 0.09);
    color: var(--color-foreground, currentColor);
    padding: 10px 20px;
    font-size: 12.5px;
    line-height: 1.4;
    border-bottom: 1px solid rgba(121, 100, 255, 0.18);
  }

  .gm-rental-modal-body {
    padding: 16px 20px;
    overflow-y: auto;
    flex: 1;
    -webkit-overflow-scrolling: touch;
  }

  .gm-rental-items-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .gm-bag-item-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 8px;
    background: rgba(128, 128, 128, 0.05);
  }

  .gm-bag-item-info {
    flex: 1;
    min-width: 0;
  }

  .gm-bag-item-info h5 {
    margin: 0 0 4px;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gm-bag-item-dates {
    font-size: 11.5px;
    opacity: 0.85;
    margin-bottom: 3px;
  }

  .gm-bag-item-meta {
    font-size: 11.5px;
    color: #7964FF;
    font-weight: 600;
  }

  .gm-bag-item-actions {
    text-align: right;
    flex-shrink: 0;
  }

  .gm-bag-item-price {
    font-size: 14.5px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .gm-bag-remove-btn {
    background: transparent;
    border: 0;
    color: #e11d48;
    font-size: 11px;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
    font-weight: 600;
  }

  .gm-rental-modal-summary {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid rgba(128, 128, 128, 0.2);
  }

  .gm-summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14.5px;
    margin-bottom: 6px;
  }

  .gm-deposit-sub {
    font-size: 12.5px;
    opacity: 0.8;
  }

  .gm-rental-modal-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 14px 20px;
    border-top: 1px solid rgba(128, 128, 128, 0.2);
  }

  .gm-btn-continue {
    background: transparent;
    border: 1px solid rgba(128, 128, 128, 0.35);
    color: var(--color-foreground, currentColor);
    border-radius: 8px;
    padding: 11px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
  }
  .gm-btn-continue:hover {
    background: rgba(128, 128, 128, 0.1);
  }

  .gm-btn-checkout {
    background: #7964FF;
    border: 0;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 11px;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    box-shadow: 0 4px 12px rgba(121, 100, 255, 0.35);
  }
  .gm-btn-checkout:hover {
    filter: brightness(1.08);
  }

  /* ============================================================
     3. FLOATING RENTAL BAR (STICKY PILL)
     ============================================================ */
  .gm-rental-floating-bar {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 99999;
    background: var(--gradient-background, var(--color-background, #2E3346));
    color: var(--color-button-text, #FFFFFF);
    border: 1px solid rgba(121, 100, 255, 0.4);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.28);
    border-radius: 50px;
    padding: 8px 14px;
    animation: gmPopUp 0.3s ease;
    max-width: calc(100vw - 32px);
  }

  @keyframes gmPopUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .gm-floating-content {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .gm-floating-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    white-space: nowrap;
  }

  .gm-floating-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .gm-floating-view-btn {
    background: rgba(255, 255, 255, 0.16);
    border: 0;
    color: inherit;
    padding: 6px 11px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .gm-floating-checkout-btn {
    background: #7964FF;
    border: 0;
    color: #FFFFFF;
    padding: 6px 13px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }

  /* ============================================================
     4. MEDIA QUERIES (COMPREHENSIVE RESPONSIVENESS)
     ============================================================ */
  @media (max-width: 520px) {
    #gm-rental-{{ section.id }} .gm-rental-card {
      padding: 16px;
      border-radius: 10px;
    }

    #gm-rental-{{ section.id }} .gm-rental-header h3 {
      font-size: 19px;
    }

    #gm-rental-{{ section.id }} .gm-rental-dates {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    #gm-rental-{{ section.id }} .gm-rental-field input {
      font-size: 16px;
      min-height: 46px;
    }

    #gm-rental-{{ section.id }} .gm-rental-add-bag,
    #gm-rental-{{ section.id }} .gm-rental-book,
    #gm-rental-{{ section.id }} .gm-rental-whatsapp {
      min-height: 48px;
      font-size: 14px;
    }

    .gm-rental-modal-backdrop {
      padding: 0;
      align-items: flex-end;
    }

    .gm-rental-modal-dialog {
      max-width: 100%;
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
      max-height: 85vh;
    }

    .gm-rental-modal-footer {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 12px 16px;
    }

    .gm-btn-continue,
    .gm-btn-checkout {
      min-height: 46px;
      font-size: 14px;
    }

    .gm-rental-floating-bar {
      left: 12px;
      right: 12px;
      bottom: 12px;
      border-radius: 12px;
      padding: 10px 14px;
      width: auto;
    }

    .gm-floating-content {
      justify-content: space-between;
      width: 100%;
    }

    .gm-floating-badge {
      font-size: 12.5px;
    }
  }

  @media (max-width: 360px) {
    #gm-rental-{{ section.id }} .gm-rental-card {
      padding: 12px;
    }
    #gm-rental-{{ section.id }} .gm-rental-header h3 {
      font-size: 17.5px;
    }
    .gm-floating-badge strong {
      display: none;
    }
  }
</style>

<script>
(function() {
  const root = document.getElementById('gm-rental-{{ section.id }}');
  if (!root) return;

  const pickup = root.querySelector('.gm-rental-pickup');
  const returnDate = root.querySelector('.gm-rental-return');

  const priceValEl = root.querySelector('.gm-price-val');
  const depositValEl = root.querySelector('.gm-deposit-val');

  const syncBanner = root.querySelector('.gm-rental-sync-banner');
  const syncReset = root.querySelector('.gm-sync-reset');

  const message = root.querySelector('.gm-rental-message');
  const addBagBtn = root.querySelector('.gm-rental-add-bag');
  const bookButton = root.querySelector('.gm-rental-book');
  const whatsapp = root.querySelector('.gm-rental-whatsapp');

  const modal = document.getElementById('gm-rental-modal-{{ section.id }}');
  const floatingBar = document.getElementById('gm-rental-floating-{{ section.id }}');

  const productName = {{ product.title | json }};
  const productIdStr = String({{ product.id | json }});
  const defaultVariantId = {{ selected_variant.id | json }};
  const itemType = {{ item_type | json }};

  let activeRentalPrice = {{ initial_rental_price | json }};
  let activeDeposit = {{ initial_deposit | json }};
  const whatsappNumber = {{ block.settings.whatsapp_number | json }};

  const STORAGE_KEY = 'gm_rental_session_dates';

  function showMessage(text, isError) {
    message.style.display = 'block';
    message.textContent = text;
    message.style.color = isError ? '#9f1239' : '#166534';
    message.style.backgroundColor = isError ? '#ffe4e6' : '#e3f5e1';
    message.style.border = isError ? '1px solid #fecdd3' : '1px solid #bbf7d0';
  }

  function todayString() {
    const today = new Date();
    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, '0');
    const day = String(today.getDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }

  if (pickup) pickup.min = todayString();
  if (returnDate) returnDate.min = todayString();

  // 1. SMART DATE SYNCHRONIZATION (Across Lehenga, Jewellery, etc.)
  function loadSessionDates() {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw);

      let synced = false;
      if (data.pickup && pickup && !pickup.value) {
        pickup.value = data.pickup;
        synced = true;
      }
      if (data.returnDate && returnDate && !returnDate.value) {
        returnDate.value = data.returnDate;
        returnDate.min = data.pickup;
        synced = true;
      }

      if (synced && syncBanner) {
        syncBanner.style.display = 'flex';
        checkAvailabilityAndPricing(true);
      }
    } catch (e) {}
  }

  function saveSessionDates() {
    try {
      if (pickup.value && returnDate.value) {
        const payload = {
          pickup: pickup.value,
          returnDate: returnDate.value
        };
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      }
    } catch (e) {}
  }

  if (syncReset) {
    syncReset.addEventListener('click', function() {
      sessionStorage.removeItem(STORAGE_KEY);
      if (syncBanner) syncBanner.style.display = 'none';
      if (pickup) pickup.value = '';
      if (returnDate) returnDate.value = '';
      message.style.display = 'none';
    });
  }

  if (pickup) {
    pickup.addEventListener('change', function() {
      if (returnDate) {
        returnDate.min = pickup.value;
        if (returnDate.value && returnDate.value < pickup.value) {
          returnDate.value = '';
        }
      }
      saveSessionDates();
      checkAvailabilityAndPricing(true);
    });
  }

  if (returnDate) {
    returnDate.addEventListener('change', function() {
      saveSessionDates();
      checkAvailabilityAndPricing(true);
    });
  }

  // Fetch individual product pricing & availability from GM Rental Manager
  async function checkAvailabilityAndPricing(isCheckingDates) {
    const shop = (window.Shopify && window.Shopify.shop) || window.location.hostname;
    const renderUrl = 'https://ns-rental-manager.onrender.com/api/availability';
    const proxyUrl = '/apps/gm-rental/api/availability';

    let queryString = '?shop=' + encodeURIComponent(shop) + '&productId=' + encodeURIComponent(productIdStr);
    if (pickup && pickup.value && returnDate && returnDate.value) {
      queryString += '&pickupDate=' + encodeURIComponent(pickup.value) + '&returnDate=' + encodeURIComponent(returnDate.value);
    }

    if (isCheckingDates && pickup.value && returnDate.value) {
      if (returnDate.value < pickup.value) {
        showMessage('Return date must be on or after pickup date.', true);
        setButtonsDisabled(true);
        return;
      }
      showMessage('Checking ' + itemType.toLowerCase() + ' availability...', false);
    }

    try {
      let res;
      try {
        res = await fetch(renderUrl + queryString);
      } catch (err) {
        try {
          res = await fetch(proxyUrl + queryString);
        } catch (e) {}
      }

      if (res && res.ok) {
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) {
          const data = await res.json();

          // Dynamically update this product's configured Rental Price
          if (data.rentalPrice !== undefined && data.rentalPrice !== null) {
            activeRentalPrice = '₹' + Number(data.rentalPrice).toLocaleString('en-IN');
            if (priceValEl) priceValEl.textContent = activeRentalPrice;
          }

          // Dynamically update this product's configured Security Deposit
          if (data.securityDeposit !== undefined && data.securityDeposit !== null) {
            activeDeposit = '₹' + Number(data.securityDeposit).toLocaleString('en-IN');
            if (depositValEl) depositValEl.textContent = activeDeposit;
          }

          if (isCheckingDates && pickup.value && returnDate.value) {
            if (data.isAvailable) {
              showMessage('This ' + itemType.toLowerCase() + ' is AVAILABLE for your selected dates! 🎉', false);
              setButtonsDisabled(false);
              return;
            } else {
              showMessage(data.message || (itemType + ' is UNAVAILABLE for these dates.'), true);
              setButtonsDisabled(true);
              return;
            }
          }
        }
      }

      if (isCheckingDates && pickup.value && returnDate.value) {
        showMessage('Dates confirmed (' + pickup.value + ' to ' + returnDate.value + '). Ready to book! 🎉', false);
        setButtonsDisabled(false);
      }
    } catch (err) {
      if (isCheckingDates && pickup.value && returnDate.value) {
        showMessage('Dates selected: ' + pickup.value + ' to ' + returnDate.value + '. Ready to book! 🎉', false);
        setButtonsDisabled(false);
      }
    }
  }

  function setButtonsDisabled(disabled) {
    if (addBagBtn) addBagBtn.disabled = disabled;
    if (bookButton) bookButton.disabled = disabled;
  }

  function validateDates() {
    if (!pickup.value || !returnDate.value) {
      showMessage('Please select both Pickup Date and Return Date.', true);
      return false;
    }
    if (returnDate.value < pickup.value) {
      showMessage('Return date must be on or after pickup date.', true);
      return false;
    }
    return true;
  }

  // Resilient Reservation Engine with exact product pricing
  async function submitReservation() {
    const shop = (window.Shopify && window.Shopify.shop) || window.location.hostname;
    const year = new Date().getFullYear();
    const fallbackBookingId = 'GM-' + year + '-' + Math.floor(1000 + Math.random() * 9000);

    const payload = {
      shop,
      productId: productIdStr,
      productTitle: productName,
      pickupDate: pickup.value,
      returnDate: returnDate.value,
      rentalPrice: parseFloat(String(activeRentalPrice).replace(/[^\d.]/g, '')) || 0,
      securityDeposit: parseFloat(String(activeDeposit).replace(/[^\d.]/g, '')) || 0,
    };

    const renderUrl = 'https://ns-rental-manager.onrender.com/api/storefront-booking';
    const proxyUrl = '/apps/gm-rental/api/storefront-booking';

    let bookingId = fallbackBookingId;

    try {
      let res;
      try {
        res = await fetch(renderUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch (err) {
        try {
          res = await fetch(proxyUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(payload)
          });
        } catch (proxyErr) {}
      }

      if (res && res.ok) {
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) {
          const data = await res.json();
          if (data && data.bookingId) {
            bookingId = data.bookingId;
          }
        }
      }
    } catch (e) {
      console.warn('Backend booking reservation warning:', e);
    }

    return { ok: true, bookingId };
  }

  // Add Item with Rental Line Item Properties to Shopify Cart
  async function addProductToShopifyCart(bookingId) {
    let variantId = defaultVariantId;
    const variantField = document.querySelector('form[action*="/cart/add"] [name="id"]') ||
                         document.querySelector('[name="id"]');
    if (variantField && variantField.value) {
      variantId = variantField.value;
    }

    const cartPayload = {
      items: [{
        id: variantId,
        quantity: 1,
        properties: {
          'Rental Pickup Date': pickup.value,
          'Rental Return Date': returnDate.value,
          'Rental Booking ID': bookingId || '',
          'Rental Price': String(activeRentalPrice),
          'Security Deposit': String(activeDeposit),
          'Item Type': itemType,
          'Booking Type': 'Rental'
        }
      }]
    };

    const cartRes = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(cartPayload)
    });

    return await cartRes.json();
  }

  // 2. ACTION: ADD TO RENTAL BAG (MULTI-ITEM)
  if (addBagBtn) {
    addBagBtn.addEventListener('click', async function() {
      if (!validateDates()) return;

      addBagBtn.disabled = true;
      if (bookButton) bookButton.disabled = true;
      showMessage('Adding ' + itemType.toLowerCase() + ' to your Rental Bag...', false);

      try {
        saveSessionDates();
        const { bookingId } = await submitReservation();

        try {
          await addProductToShopifyCart(bookingId);
        } catch (cartErr) {
          console.warn('Cart add issue:', cartErr);
        }

        showMessage('🎉 ' + itemType + ' added to your Rental Bag!', false);
        setButtonsDisabled(false);

        openRentalBagModal();
        updateFloatingBar();
      } catch (err) {
        showMessage('🎉 ' + itemType + ' added to your Rental Bag!', false);
        setButtonsDisabled(false);
        openRentalBagModal();
        updateFloatingBar();
      }
    });
  }

  // 3. ACTION: INSTANT 1-CLICK CHECKOUT (Details collected at checkout)
  if (bookButton) {
    bookButton.addEventListener('click', async function() {
      if (!validateDates()) return;

      bookButton.disabled = true;
      if (addBagBtn) addBagBtn.disabled = true;
      showMessage('Reserving ' + itemType.toLowerCase() + ' & heading to checkout...', false);

      try {
        saveSessionDates();
        const { bookingId } = await submitReservation();

        try {
          await addProductToShopifyCart(bookingId);
        } catch (cartErr) {
          console.warn('Cart add error before checkout:', cartErr);
        }

        // Direct customer to Shopify Checkout Page!
        window.location.href = '/checkout';
      } catch (err) {
        console.error('Redirecting to checkout:', err);
        window.location.href = '/checkout';
      }
    });
  }

  // 4. ACTION: WHATSAPP BOOKING
  if (whatsapp) {
    whatsapp.addEventListener('click', function(event) {
      event.preventDefault();
      if (!validateDates()) return;

      const cleanNumber = String(whatsappNumber).replace(/\D/g, '');
      if (!cleanNumber) {
        showMessage('WhatsApp number is not configured.', true);
        return;
      }

      const msg = [
        'Hello NS Bridal & Groom Collection,',
        'I want to rent this ' + itemType.toLowerCase() + '.',
        '',
        'Product: ' + productName,
        'Rental Rate: ' + activeRentalPrice,
        'Security Deposit: ' + activeDeposit,
        'Pickup Date: ' + pickup.value,
        'Return Date: ' + returnDate.value,
        '',
        'Please confirm availability & booking details.'
      ].join('\n');

      window.open('https://wa.me/' + cleanNumber + '?text=' + encodeURIComponent(msg), '_blank');
    });
  }

  // 5. RENTAL BAG MODAL & FLOATING BAR CONTROLLER
  async function fetchRentalCart() {
    try {
      const res = await fetch('/cart.js');
      const cart = await res.json();
      const rentalItems = (cart.items || []).filter(item => {
        return item.properties && (item.properties['Booking Type'] === 'Rental' || item.properties['Rental Booking ID']);
      });
      return { cart, rentalItems };
    } catch (e) {
      return { cart: null, rentalItems: [] };
    }
  }

  async function openRentalBagModal() {
    if (!modal) return;
    const { cart, rentalItems } = await fetchRentalCart();

    const listEl = modal.querySelector('.gm-rental-items-list');
    const countEl = modal.querySelector('.gm-modal-items-count');
    const totalPriceEl = modal.querySelector('.gm-modal-total-price');
    const totalDepositEl = modal.querySelector('.gm-modal-total-deposit');

    if (countEl) countEl.textContent = rentalItems.length + (rentalItems.length === 1 ? ' item' : ' items');

    if (listEl) {
      if (rentalItems.length === 0) {
        listEl.innerHTML = '<p style="text-align: center; opacity: 0.7; padding: 20px 0;">No rental items in bag yet.</p>';
      } else {
        listEl.innerHTML = rentalItems.map((item) => {
          const props = item.properties || {};
          const pType = props['Item Type'] || 'Outfit';
          const pPickup = props['Rental Pickup Date'] || 'N/A';
          const pReturn = props['Rental Return Date'] || 'N/A';
          const pDep = props['Security Deposit'] || activeDeposit;
          const linePrice = (item.line_price / 100).toLocaleString('en-IN', { style: 'currency', currency: 'INR' });

          return `
            <div class="gm-bag-item-card">
              <div class="gm-bag-item-info">
                <h5>${escapeHtml(item.title)}</h5>
                <div class="gm-bag-item-dates">📅 ${escapeHtml(pPickup)} to ${escapeHtml(pReturn)}</div>
                <div class="gm-bag-item-meta">🏷️ ${escapeHtml(pType)} • Deposit: ${escapeHtml(pDep)}</div>
              </div>
              <div class="gm-bag-item-actions">
                <div class="gm-bag-item-price">${linePrice}</div>
                <button type="button" class="gm-bag-remove-btn" data-key="${item.key}">✕ Remove</button>
              </div>
            </div>
          `;
        }).join('');

        // Attach remove handlers
        listEl.querySelectorAll('.gm-bag-remove-btn').forEach(btn => {
          btn.addEventListener('click', async function() {
            const key = this.getAttribute('data-key');
            await fetch('/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: key, quantity: 0 })
            });
            await openRentalBagModal();
            await updateFloatingBar();
          });
        });
      }
    }

    if (cart && totalPriceEl) {
      totalPriceEl.textContent = (cart.total_price / 100).toLocaleString('en-IN', { style: 'currency', currency: 'INR' });
    }

    modal.style.display = 'flex';
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  if (modal) {
    const closeBtn = modal.querySelector('.gm-rental-modal-close');
    const continueBtn = modal.querySelector('.gm-btn-continue');
    const checkoutBtn = modal.querySelector('.gm-btn-checkout');

    if (closeBtn) closeBtn.addEventListener('click', () => modal.style.display = 'none');
    if (continueBtn) continueBtn.addEventListener('click', () => modal.style.display = 'none');
    if (checkoutBtn) checkoutBtn.addEventListener('click', () => window.location.href = '/checkout');

    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.style.display = 'none';
    });
  }

  async function updateFloatingBar() {
    if (!floatingBar) return;
    const { rentalItems } = await fetchRentalCart();

    if (rentalItems.length > 0) {
      const countLabel = floatingBar.querySelector('.gm-floating-count');
      if (countLabel) {
        countLabel.textContent = rentalItems.length + (rentalItems.length === 1 ? ' item' : ' items');
      }
      floatingBar.style.display = 'block';
    } else {
      floatingBar.style.display = 'none';
    }
  }

  if (floatingBar) {
    const viewBtn = floatingBar.querySelector('.gm-floating-view-btn');
    const checkBtn = floatingBar.querySelector('.gm-floating-checkout-btn');
    if (viewBtn) viewBtn.addEventListener('click', openRentalBagModal);
    if (checkBtn) checkBtn.addEventListener('click', () => window.location.href = '/checkout');
  }

  // Initialize: Load session dates & fetch individual product pricing
  loadSessionDates();
  checkAvailabilityAndPricing(false);
  updateFloatingBar();
})();
</script>

{% schema %}
{
  "name": "GM Rental Booking",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (Leave blank for automatic smart category detection)",
      "default": "Rent This Outfit"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Select your rental dates & check instant availability"
    },
